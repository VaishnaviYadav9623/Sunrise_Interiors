MONGODB_URI=
JWT_SECRET=
PORT=5000

# Gmail defaults are used if SMTP_HOST, SMTP_PORT, or SMTP_SECURE are omitted.
# Only set SMTP_USER and SMTP_PASS after creating a Google app password.
# Optional: set SMTP_FROM to a verified sender address for this account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
